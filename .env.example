# Copie para .env apenas na sua máquina. Não commite segredo.
# No Render, cadastre os mesmos nomes em Environment. Não cole estes valores no Git.

DATABASE_URL=postgres://USUARIO:SENHA@HOST:5432/BANCO
JWT_SECRET=substitua_por_texto_aleatorio_com_24_ou_mais_caracteres
ADMIN_PASSWORD=substitua_por_senha_forte
STORE_LOGIN_NAME=nome_de_acesso_da_loja
WHATSAPP=5511999999999
PIX_KEY=
CORS_ORIGIN=https://wg-loja-render.onrender.com
PORT=3000

# Mercado Pago — somente teste até a revisão de produção.
# Cole o Access Token de teste e o segredo do webhook no painel do Render, nunca aqui.
MP_ACCESS_TOKEN=SUBSTITUA_PELO_ACCESS_TOKEN_DE_TESTE
MP_WEBHOOK_SECRET=SUBSTITUA_PELO_SEGREDO_DE_ASSINATURA_DO_WEBHOOK
APP_BASE_URL=https://wg-loja-render.onrender.com
MP_MODE=test
MP_ALLOW_PRODUCTION=false
MP_MAX_INSTALLMENTS=12
MP_WEBHOOK_TOLERANCE_SECONDS=300
MP_COLLECTOR_ID=
